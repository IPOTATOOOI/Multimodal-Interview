# Copy this file to .env. Never commit the real .env file.

# Frontend: choose ONE backend URL.
# Python/FastAPI (full AI feature set): http://localhost:8000
# Java/Spring Boot (core account/history/question-bank APIs): http://localhost:8001
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8765
VITE_STABLE_DIFFUSION_URL=http://localhost:7861

# Browser-side integrations. VITE_* values are public in the browser bundle.
VITE_XUNFEI_APPID=
VITE_XUNFEI_API_KEY=
VITE_XUNFEI_API_SECRET=
VITE_SERPAPI_KEY=
VITE_AVATAR_APP_ID=
VITE_AVATAR_API_KEY=
VITE_AVATAR_API_SECRET=
VITE_AVATAR_SERVICE_ID=
VITE_AVATAR_ID=

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=swcup
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=swcup
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/swcup?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai

# Authentication (generate long random values for real deployments)
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=60
ADMIN_REGISTRATION_CODES=replace-with-private-registration-codes

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Redis and RabbitMQ
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost/

# Qwen / OpenAI-compatible services
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
OPENAI_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-4v-flash

# iFlytek services
APPID=
API_KEY=
API_SECRET=
SPARK_URL=wss://spark-api.xf-yun.com/v1/x1
DOMAIN=x1
XUNFEI_LFASR_APP_ID=
XUNFEI_LFASR_SECRET_KEY=
XUNFEI_SPARK_URL=wss://spark-api.xf-yun.com/v1/x1
XUNFEI_SPARK_API_KEY=
XUNFEI_SPARK_API_SECRET=
XUNFEI_SPARK_COMPLETIONS_URL=https://spark-api-open.xf-yun.com/v2/chat/completions

# Optional services
CF_TURNSTILE_SECRET_KEY=
COZE_API_KEY=
COZE_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=bge-m3

# Runtime and storage (relative paths are recommended)
HOST=0.0.0.0
PORT=8000
SERVER_PORT=8001
TRANSCRIBE_URL=http://127.0.0.1:8000/api/voice/transcribe
UPLOAD_DIR=uploads/audio
VECTOR_DB_PATH=vecDB/SW_vector_db
VECTOR_DB_DIR=vecDB/SW_vector_db
EMBEDDING_MODEL_PATH=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FACIAL_LANDMARK_MODEL_PATH=facial_landmarks/shape_predictor_68_face_landmarks.dat
POSE_MODEL_PATH=facial_landmarks/pose_iter_584000.caffemodel
LIBREOFFICE_PATH=
LLM_DETAILED_LOG=false
CORS_ORIGINS=http://localhost:5173
QA_ANNOTATION_ENABLED=false
FACIAL_ANALYSIS_ENABLED=false
AUDIO_MONITOR_ENABLED=false
RELOAD=false
