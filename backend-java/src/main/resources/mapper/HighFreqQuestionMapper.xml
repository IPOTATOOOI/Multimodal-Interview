<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.spr_swcup.mapper.positionInfo.HighFreqQuestionMapper">

    <resultMap id="BaseResultMap" type="com.example.spr_swcup.entity.HighFreqQuestion">
        <id column="question_type_id" property="questionTypeId"/>
        <result column="position_id" property="positionId"/>
        <result column="question_type_name" property="questionTypeName"/>
        <result column="question_example" property="questionExample"/>
        <result column="scoring_focus" property="scoringFocus"/>
        <result column="answer_template" property="answerTemplate"/>
    </resultMap>
    <select id="findByPositionId" resultMap="BaseResultMap">
        SELECT question_type_id, position_id, question_type_name,
               question_example, scoring_focus, answer_template
        FROM high_freq_questions
        WHERE position_id = #{positionId}
    </select>
</mapper>