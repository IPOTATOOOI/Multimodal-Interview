<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.spr_swcup.mapper.positionInfo.CoreCompetenceMapper">
    <resultMap id="BaseResultMap" type="com.example.spr_swcup.entity.CoreCompetence">
        <id column="competence_id" property="competenceId"/>
        <result column="position_id" property="positionId"/>
        <result column="competence_name" property="competenceName"/>
        <result column="competence_description" property="competenceDescription"/>
    </resultMap>

    <select id="findByPositionId" resultMap="BaseResultMap">
        SELECT competence_id, position_id, competence_name, competence_description
        FROM core_competences
        WHERE position_id = #{positionId}
    </select>
</mapper>