<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.spr_swcup.mapper.positionInfo.DomainMapper">
    <resultMap id="BaseResultMap" type="com.example.spr_swcup.entity.Domain">
        <id column="domain_id" property="domainId"/>
        <result column="domain_name" property="domainName"/>
    </resultMap>

    <select id="findByDomainName" resultMap="BaseResultMap">
        SELECT domain_id, domain_name
        FROM domains
        WHERE domain_name = #{domainName}
    </select>
</mapper>

