<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.spr_swcup.mapper.positionInfo.TermMapper">

    <resultMap id="BaseResultMap" type="com.example.spr_swcup.entity.Term">
        <id column="term_id" property="termId"/>
        <result column="position_id" property="positionId"/>
        <result column="term_name" property="termName"/>
        <result column="term_explanation" property="termExplanation"/>
        <result column="frequency" property="frequency"/>
    </resultMap>
    <select id="findByPositionId" resultMap="BaseResultMap">
        SELECT term_id, position_id, term_name, term_explanation, frequency
        FROM terms
        WHERE position_id = #{positionId}
    </select>
</mapper>