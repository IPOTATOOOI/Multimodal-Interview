<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spr_swcup.mapper.history.QAMapper">
    
    <resultMap id="QAResultMap" type="com.example.spr_swcup.dto.history.QADTO">
        <id column="qa_id" property="qaId"/>
        <result column="history_id" property="historyId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="created_at" property="createdAt"/>
        <result column="evaluation" property="evaluation"/>
        <result column="feedback" property="feedback"/>
        <result column="key_words" property="keyWords"/>
        <result column="reference_a" property="referenceA"/>
        <result column="difficulty" property="difficulty"/>
        <result column="skill" property="skill"/>
        <result column="answer_rating" property="answerRating"/>
        <result column="category" property="category"/>
    </resultMap>
    
    <select id="getQAByHistoryId" resultMap="QAResultMap">
        SELECT * FROM qa 
        WHERE history_id = #{historyId} 
        ORDER BY created_at ASC
    </select>
    
</mapper> 